# The Kai Events server from example_05 / example_06. Start it first:
#   cd ../server && npm install && npm run dev
#
# NOTE: anything prefixed VITE_ is compiled into the browser bundle and is
# PUBLIC. It is configuration, not a secret. This is the same reason the
# Firebase Admin SDK never goes near the phone.
VITE_KAI_SERVER=http://localhost:3734
